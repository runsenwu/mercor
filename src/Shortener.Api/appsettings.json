{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Database=shortener;Username=shortener;Password=shortener;Maximum Pool Size=100",
    "Redis": "redis:6379",
    "RabbitMq": "amqp://shortener:shortener@rabbitmq:5672/"
  },
  "Shortener": { "PublicBaseUrl": "http://localhost:8080" },
  "Cache": { "Enabled": true, "TtlSeconds": 3600, "NegativeTtlSeconds": 60 },
  "Clicks": { "Mode": "queue", "BufferCapacity": 10000 },
  "RateLimits": { "AnonymousCreatesPerMinute": 20, "AnonymousReadsPerMinute": 300 },
  "ApiKeys": [
    { "Name": "demo", "Key": "demo-key-change-me", "PermitsPerMinute": 600 },
    { "Name": "loadtest", "Key": "loadtest-key-change-me", "PermitsPerMinute": 100000000 }
  ],
  "Telemetry": { "TraceSampleRatio": 1.0 }
}
