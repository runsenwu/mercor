# Copy to deploy/.env (auto-loaded by compose) or ./.env (passed by the Makefile). All values are defaults.
API_REPLICAS=2
API_CPUS=1
API_MEMORY=512M
API_DB_MAX_POOL_SIZE=100
WORKER_REPLICAS=1
WORKER_CPUS=0.5
WORKER_MEMORY=256M
WORKER_DB_MAX_POOL_SIZE=100
WORKER_PREFETCH=1000
WORKER_BATCH_SIZE=500
WORKER_BATCH_MAX_WAIT_MS=1000
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_NEGATIVE_TTL_SECONDS=60
CLICKS_MODE=queue
CLICKS_BUFFER_CAPACITY=10000
RATELIMIT_ANON_CREATES_PER_MINUTE=20
RATELIMIT_ANON_READS_PER_MINUTE=300
TRACE_SAMPLE_RATIO=1.0
TAIL_SAMPLING_PERCENT=10
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_CPUS=2
REDIS_MAXMEMORY=256mb
NGINX_CPUS=2
PUBLIC_BASE_URL=http://localhost:8080
